namespace ChatPlatform.Infrastructure.Messaging
{
    public sealed class InMemoryEventBus : IEventBus
    {
        private readonly ConcurrentDictionary<Guid, Channel<PlatformEvent>> _subs = new();

        public async ValueTask PublishAsync(PlatformEvent evt, CancellationToken ct = default)
        {
            foreach (var ch in _subs.Values)
                try { await ch.Writer.WriteAsync(evt, ct); }
                catch (ChannelClosedException) { }
        }

        public async IAsyncEnumerable<PlatformEvent> SubscribeAsync(
            [EnumeratorCancellation] CancellationToken ct)
        {
            var id = Guid.NewGuid();
            var ch = Channel.CreateUnbounded<PlatformEvent>(
                new UnboundedChannelOptions { SingleReader = true });
            _subs[id] = ch;
            try { await foreach (var e in ch.Reader.ReadAllAsync(ct)) yield return e; }
            finally { _subs.TryRemove(id, out _); ch.Writer.TryComplete(); }
        }
    }
}

namespace ChatPlatform.Infrastructure.Data
{
    public sealed class PlatformDbContext : DbContext
    {
        public PlatformDbContext(DbContextOptions<PlatformDbContext> o) : base(o) { }
        public DbSet<WebhookSubscription> WebhookSubscriptions => Set<WebhookSubscription>();

        protected override void OnModelCreating(ModelBuilder mb) =>
            mb.Entity<WebhookSubscription>(e =>
            {
                e.HasKey(x => x.Id);
                e.Property(x => x.Url).IsRequired().HasMaxLength(2048);
                e.Property(x => x.Secret).IsRequired().HasMaxLength(256);
                e.Property(x => x.EventTypes).IsRequired().HasMaxLength(512);
                e.HasIndex(x => x.IsActive);
            });
    }
}

namespace ChatPlatform.Infrastructure.Webhooks
{
    public static class HmacSigner
    {
        public static string Sign(string payload, string secret)
        {
            using var h = new HMACSHA256(Encoding.UTF8.GetBytes(secret));
            return "sha256=" + Convert.ToHexString(h.ComputeHash(Encoding.UTF8.GetBytes(payload))).ToLowerInvariant();
        }
    }

    public sealed class WebhookDispatcher : BackgroundService
    {
        private readonly IEventBus _bus;
        private readonly IServiceScopeFactory _sf;
        private readonly IHttpClientFactory _hf;
        private readonly ILogger<WebhookDispatcher> _log;

        public WebhookDispatcher(IEventBus b, IServiceScopeFactory sf,
            IHttpClientFactory hf, ILogger<WebhookDispatcher> log)
            => (_bus, _sf, _hf, _log) = (b, sf, hf, log);

        protected override async Task ExecuteAsync(CancellationToken ct)
        {
            await foreach (var e in _bus.SubscribeAsync(ct))
                try { await Dispatch(e, ct); }
                catch (Exception ex) { _log.LogError(ex, "dispatch failed"); }
        }

        private async Task Dispatch(PlatformEvent evt, CancellationToken ct)
        {
            using var scope = _sf.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<PlatformDbContext>();
            var subs = await db.WebhookSubscriptions.Where(s => s.IsActive).ToListAsync(ct);
            var match = subs.Where(s => Match(s.EventTypes, evt.Type)).ToList();
            if (match.Count == 0) return;

            var payload = JsonSerializer.Serialize(evt);
            var client = _hf.CreateClient("webhooks");

            foreach (var s in match)
            {
                var sig = HmacSigner.Sign(payload, s.Secret);
                var (_, st) = await Deliver(client, s, evt, payload, sig, ct);
                s.LastDeliveryAt = DateTimeOffset.UtcNow;
                s.LastDeliveryStatus = st;
            }
            await db.SaveChangesAsync(ct);
        }

        private static bool Match(string types, string t) =>
            types == "*" || types.Split(',', StringSplitOptions.TrimEntries)
                .Any(x => x == t || (x.EndsWith(".*") && t.StartsWith(x[..^1])));

        private static async Task<(bool, string)> Deliver(
            HttpClient c, WebhookSubscription s, PlatformEvent e,
            string p, string sig, CancellationToken ct)
        {
            for (int i = 1; i <= 3; i++)
            {
                try
                {
                    using var r = new HttpRequestMessage(HttpMethod.Post, s.Url)
                    { Content = new StringContent(p, Encoding.UTF8, "application/json") };
                    r.Headers.Add("X-Webhook-Signature", sig);
                    r.Headers.Add("X-Webhook-Event", e.Type);
                    using var resp = await c.SendAsync(r, ct);
                    if (resp.IsSuccessStatusCode) return (true, ((int)resp.StatusCode).ToString());
                }
                catch { if (i == 3) return (false, "error"); }
                if (i < 3) await Task.Delay(TimeSpan.FromSeconds(1 << i), ct);
            }
            return (false, "max-retries");
        }
    }
}
