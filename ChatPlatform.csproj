<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Keep the separate smoke test project out of production compilation/publish. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- قاعدة البيانات (SQLite) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.34" />
    <!-- EF Core 8 still resolves an older bundled native SQLite library. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    
    <!-- أدوات إنشاء الـ Migrations (لا تُنشر مع التطبيق) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.34">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- تشفير التوكنات وحفظ المفاتيح في قاعدة البيانات (IDataProtection) -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="8.0.34" />

    <!-- مكتبة Polly لإعادة المحاولة (Resilience) -->
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.34" />
  </ItemGroup>

</Project>
